{
  "name": "dylan-a-day",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test a11y",
    "deduplicate": "npx tsx scripts/deduplicate-images.ts",
    "optimize": "npx tsx scripts/optimize-images.ts",
    "optimize:videos": "npx tsx scripts/optimize-videos.ts",
    "optimize:all": "npm run optimize && npm run optimize:videos",
    "predeploy": "npm run optimize:all && npm run build"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "minimatch@3": ">=3.1.3",
    "nanoid@3": "^3.3.18",
    "brace-expansion@5": "^5.0.9",
    "sharp": "^0.35.3",
    "next": {
      "postcss": "^8.5.18"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "^4.0.1",
    "serve": "^14.2.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
